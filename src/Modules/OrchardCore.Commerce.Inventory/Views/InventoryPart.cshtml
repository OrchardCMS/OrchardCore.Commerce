@model InventoryPartViewModel

@if (Model.Inventory is { } inventory)
{
    <div class="pb-3 field field-type-numericfield field-name-inventory-part-inventory">
        @foreach (var (inventoryKey, count) in inventory)
        {
            var inventoryTitle = Model.Titles[inventoryKey];

            <span class="d-block w-100">
                <strong class="field-name-inventory-part-inventory-title">
                    @(string.IsNullOrEmpty(inventoryTitle) ? T["Inventory"] : T["{0} Inventory", inventoryTitle]):
                </strong>
                @count
            </span>
        }
    </div>
}
