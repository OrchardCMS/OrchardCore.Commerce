@model PriceVariantsPartViewModel

<h3>Price variants</h3>

<div class="row">
    @foreach (var variantKey in Model.VariantsValues.Keys)
    {
        <div class="col-md-3">
            <div class="mb-3" asp-validation-class-for="VariantsValues[variantKey]">
                <label asp-for="VariantsValues[variantKey]">@T["{0} Price", variantKey]</label>
                <div class="input-group">
                    <input asp-for="VariantsValues[variantKey]"
                           class="form-control text-muted variant-price-value"
                           required />
                    <div class="input-group-append">
                        <select asp-for="VariantsCurrencies[variantKey]"
                                class="form-select"
                                asp-items="@(new SelectList(Model.Currencies, "CurrencyIsoCode", "CurrencyIsoCode"))"
                                required></select>
                    </div>
                </div>
                <span asp-validation-for="VariantsValues[variantKey]"></span>
            </div>
        </div>
    }
</div>
