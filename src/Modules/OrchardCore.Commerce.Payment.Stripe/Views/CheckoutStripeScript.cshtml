@using OrchardCore.Commerce.Payment.Stripe.Models
@using System.Collections

@{
    if (Model.PaymentProviderData is not StripePaymentProviderData paymentProviderData)
    {
        return;
    }
    
    var publishableKey = paymentProviderData.PublishableKey;
    var clientSecret = paymentProviderData.ClientSecret;
    var paymentIntentId = paymentProviderData.PaymentIntentId;
    var accountId = paymentProviderData.AccountId?.Trim();
    
    var urlPrefix = Url.Content("~/").TrimEnd('/');
    var missingText = T["A value is required for %LABEL%."].Value;
    var stripeData = new
    {
        clientSecret,
        paymentIntentId,
        urlPrefix,
        publishableKey,
        missingText,
    }; 
}

@if (!string.IsNullOrEmpty(publishableKey))
{
    <script at="Head" asp-name="StripeJs" asp-src="https://js.stripe.com/v3/"></script>
    <script at="Head" asp-name="@ResourceNames.StripePaymentForm"></script>
    <script at="Foot" depends-on="StripeJs,StripePaymentForm">
        const stripeAccountId = @(string.IsNullOrEmpty(accountId) ? Html.Raw("undefined") : Json.Serialize(new { StripeAccount = accountId }));
        const data = {
            ... @Json.Serialize(stripeData),
            stripeAccountId,
            ... @Json.Serialize(Model.AdditionalData as IDictionary ?? new Dictionary<string, object>()),
        };
        
        stripePaymentForm(data);
    </script>
}
