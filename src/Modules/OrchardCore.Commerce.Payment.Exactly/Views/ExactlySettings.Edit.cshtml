@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Mvc.Localization
@using OrchardCore
@using OrchardCore.Commerce.Payment.Abstractions
@using OrchardCore.Commerce.Payment.Exactly.Controllers
@using OrchardCore.Commerce.Payment.Exactly.Drivers
@model OrchardCore.Commerce.Payment.Exactly.ViewModels.ExactlySettingsViewModel

<p class="alert alert-info exactly-sign-up-info">
    @T["Please be sure to use <a href=\"{0}\">this link</a> to create your exactly account. That way <a href=\"https://lombiq.com/\">Lombiq</a> (the steward of the Orchard Core Commerce project) will get a commission on the payment fees, which helps cover some of the development costs of OCC. This is at no cost to you; the fees you pay are the same either way.", ExactlySettingsDisplayDriver.SignUpLink]
</p>

<div class="mb-3">
    <div>
        <a id="ExactlySettings__testButton"
            href="@(Orchard.Action<ExactlyController>(controller => controller.VerifyApi(null)))"
           class="btn btn-sm btn-primary">
            @T["Verify currently saved Production API configuration"]
        </a>
        <a id="ExactlySettings__testButtonSandbox"
            href="@(Orchard.Action<ExactlyController>(controller => controller.VerifyApi(PaymentEnvironment.Sandbox.ToQueryValue())))"
           class="btn btn-sm btn-secondary">
            @T["Verify currently saved Sandbox API configuration"]
        </a>
    </div>
    <span class="hint">
        @T["Warning: pressing these buttons won't save the current page. If you have edited any fields they get disabled."]
    </span>
</div>

<h4>@T["Production"]</h4>

<fieldset asp-for="Production.BaseAddress"
          label="@T["Base Address"]"
          hint="@T["The Exactly Production API base URL."]"></fieldset>

<fieldset asp-for="Production.ProjectId"
          label="@T["Project ID"]"
          hint="@T["The GUID identifying the Production project."]"></fieldset>

<fieldset asp-for="Production.ApiKey"
          label="@T["API key"]"
          hint="@(new HtmlString(" ").Join(
                    T["The secret API key for the Production project."],
                    T["The field will be empty after saving it, for security reasons."]))"
          type="password"></fieldset>

<h4 class="mt-4">@T["Sandbox"]</h4>

<fieldset asp-for="Sandbox.BaseAddress"
          label="@T["Base Address"]"
          hint="@T["The Exactly Sandbox API base URL."]"></fieldset>

<fieldset asp-for="Sandbox.ProjectId"
          label="@T["Project ID"]"
          hint="@T["The GUID identifying the Sandbox project."]"></fieldset>

<fieldset asp-for="Sandbox.ApiKey"
          label="@T["API key"]"
          hint="@(new HtmlString(" ").Join(
                    T["The secret API key for the Sandbox project."],
                    T["The field will be empty after saving it, for security reasons."]))"
          type="password"></fieldset>

<div class="mb-3">
    <span class="hint">
        @T["You can find your project information at <a href=\"https://dashboard.exactly.com/projects/\" target=\"_blank\">https://dashboard.exactly.com/projects/</a>."]
    </span>
</div>

<script at="Foot" depends-on="jQuery">
    jQuery(function($) {
        const buttons = [
            document.getElementById('ExactlySettings__testButton'),
            document.getElementById('ExactlySettings__testButtonSandbox'),
        ];
        const ids = @Json.Serialize(new[]
        {
            Html.IdFor(model => model.Production.ProjectId),
            Html.IdFor(model => model.Production.ApiKey),
            Html.IdFor(model => model.Production.BaseAddress),
            Html.IdFor(model => model.Sandbox.ProjectId),
            Html.IdFor(model => model.Sandbox.ApiKey),
            Html.IdFor(model => model.Sandbox.BaseAddress),
        });

        $(ids.map((id) => document.getElementById(id))).change(() => buttons.forEach((button) => button.classList.add('disabled')));
    });
</script>
